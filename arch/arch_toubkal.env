#!/bin/bash
# Author: M. EL Aabaribaoune (@um6p)
#
# arch_toubkal.env — Environment setup for LIS/LDT/LVT on Toubkal HPC
#
# Usage:
#   source arch/arch_toubkal.env
#
# This file centralizes all module loads required to run LISF
# (LIS, LDT, LVT) compiled with foss/2024a on the Toubkal cluster.
# Source it from any job script instead of duplicating module loads.

module purge
module load foss/2024a
module load netCDF-Fortran/4.6.1-gompi-2024a
module load netCDF/4.9.2-gompi-2024a
module load ESMF/8.7.0-foss-2024a
module load JasPer/4.2.4-GCCcore-13.3.0
module load ecCodes/2.38.3-gompi-2024a
module load HDF5/1.14.5-gompi-2024a
module load CMake/3.29.3-GCCcore-13.3.0

echo "[arch_toubkal] Environment loaded successfully."
module list
