# Reorganized NoahMP_Morocco Git Ignore

# Input and Output data directories (large files)
data/
logs/

# Whitelist experiments
experiments/**
!experiments/**/
!experiments/NorthMor/routing/ldt_hymap/ldt.config
!experiments/NorthMor/routing/configs/*.config
!experiments/NorthMor/routing/README_HYMAP.md
!experiments/NorthMor/routing/checks/**

# Ensure binary and NetCDF data are never tracked
*.nc
*.bin

# Older/temporary run files
fort.*
ldtlog.*
SMAP_filelist.dat

# Compiled LISF binaries (under src/)
src/lisf/lis/LIS
src/lisf/lis/make/LIS
src/lisf/ldt/LDT
src/lisf/ldt/make/LDT
src/lisf/lvt/LVT
src/lisf/lvt/make/LVT
*.o
*.mod
*.d

# Python cache
__pycache__/
*.pyc

# Figures
postproc/figures/
*.png
input/
scripts/venv/
scripts/unrar
validation/vegetation/Copernicus_LAI/raw/
scripts/download/validation/credentials_validation.py
MaskParamFill.log
