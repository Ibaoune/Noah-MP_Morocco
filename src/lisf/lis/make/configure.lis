# Configured for HPC Toubkal by M. El Aabaribaoune (@um6p)
FC              = mpif90
FC77            = mpif90
LD              = mpif90
CC              = mpicc
AR              = ar
MOD_ESMF        = /srv/software/easybuild/software/ESMF/8.7.0-foss-2024a/mod
LIB_ESMF        = /srv/software/easybuild/software/ESMF/8.7.0-foss-2024a/lib
INC_JPEG2000      = /srv/software/easybuild/software/JasPer/4.2.4-GCCcore-13.3.0/include/
LIB_JPEG2000      = /srv/software/easybuild/software/JasPer/4.2.4-GCCcore-13.3.0/lib64/
INC_ECCODES     = /srv/software/easybuild/software/ecCodes/2.38.3-gompi-2024a/include/
LIB_ECCODES     = /srv/software/easybuild/software/ecCodes/2.38.3-gompi-2024a/lib/
INC_NETCDF      = /srv/software/easybuild/software/netCDF-Fortran/4.6.1-gompi-2024a/include/ -I/srv/software/easybuild/software/netCDF/4.9.2-gompi-2024a/include/
LIB_NETCDF      = /srv/software/easybuild/software/netCDF-Fortran/4.6.1-gompi-2024a/lib/ -L/srv/software/easybuild/software/netCDF/4.9.2-gompi-2024a/lib/
INC_HDF4        = 
LIB_HDF4        = 
INC_HDF5        = /srv/software/easybuild/software/HDF5/1.14.5-gompi-2024a/include/
LIB_HDF5        = /srv/software/easybuild/software/HDF5/1.14.5-gompi-2024a/lib/
INC_HDFEOS      = 
LIB_HDFEOS      = 
LIB_MINPACK     = 
INC_CRTM        = 
LIB_CRTM        = 
INC_PROF_UTIL   = 
LIB_PROF_UTIL   = 
INC_CMEM        = 
LIB_CMEM        = 
LIB_LAPACK      = 
INC_PETSC       = 
LIB_PETSC       = 
CFLAGS          = -c  -DGFORTRAN -DLINUX -DLIS_JULES -DSM_NOAHMP_4_0_1
FFLAGS77        = -c -O2  -fbacktrace -DSPMD -fconvert=big-endian -DHIDE_SHR_MSG -DNO_SHR_VMATH -DGFORTRAN -DLINUX  -I$(MOD_ESMF) -I$(INC_ECCODES) -I$(INC_NETCDF) -I$(INC_HDF5) -DLIS_JULES -DSM_NOAHMP_4_0_1
FFLAGS          = -c -ffree-line-length-0 -O2  -fbacktrace -DSPMD -fconvert=big-endian -DHIDE_SHR_MSG -DNO_SHR_VMATH -DGFORTRAN -DLINUX  -I$(MOD_ESMF) -I$(INC_ECCODES) -I$(INC_NETCDF) -I$(INC_HDF5) -DLIS_JULES -DSM_NOAHMP_4_0_1
LDFLAGS         =  -L$(LIB_ESMF) -lesmf -lpioc -lflexiblas -lstdc++ -lz -lmpi -L$(LIB_ECCODES) -leccodes_f90 -leccodes -L$(LIB_JPEG2000) -ljasper -L$(LIB_NETCDF) -lnetcdff -lnetcdf -L$(LIB_HDF5) -lhdf5_fortran -lhdf5_hl -lhdf5 -lz
LIS_LIB_FLAGS   = -lesmf -lpioc -lflexiblas -lstdc++ -lz -leccodes_f90 -leccodes -ljasper -lnetcdff -lnetcdf -lhdf5_fortran -lhdf5_hl -lhdf5
LIS_LIB_PATHS   = -L$(LIB_ESMF) -L$(LIB_ECCODES) -L$(LIB_JPEG2000) -L$(LIB_NETCDF) -L$(LIB_HDF5)
